# A sample kubeconfig for screenshots and tests. Nothing in it is real: the
# addresses lead nowhere and the token is a placeholder.
apiVersion: v1
kind: Config
current-context: homelab
clusters:
- name: homelab
  cluster: {server: "https://192.168.1.20:6443"}
- name: kind-dev
  cluster: {server: "https://127.0.0.1:6443"}
- name: prod-eks
  cluster: {server: "https://ABCDEF0123456789.gr7.us-east-1.eks.amazonaws.com"}
users:
- name: homelab-admin
  user: {token: "sample-not-a-real-token"}
- name: kind-dev
  user: {token: "sample-not-a-real-token"}
- name: prod-eks
  user:
    exec:
      apiVersion: client.authentication.k8s.io/v1beta1
      command: aws
      args: ["eks", "get-token", "--cluster-name", "prod"]
contexts:
- name: homelab
  context: {cluster: homelab, user: homelab-admin}
- name: kind-dev
  context: {cluster: kind-dev, user: kind-dev}
- name: prod-eks
  context: {cluster: prod-eks, user: prod-eks}