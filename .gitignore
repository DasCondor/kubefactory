# downloaded by setup.ps1 / the release workflow
engine/*
!engine/.gdignore
# build output
dist/*
!dist/.gdignore
# Godot's import cache
.godot/

# local build toolchains and the native companion's build output
.toolchain/
agent/bin/


# anything a program writes into the sample home folder during a screenshot run
tests/fixtures/home/*
!tests/fixtures/home/.kube/
